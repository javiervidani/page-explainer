PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Permanent key (never expires). Optional; send in x-api-key or Authorization: Bearer
API_KEY=
# Password for the key generator on the main page. Leave empty to disable it.
ADMIN_PASSWORD=
RATE_LIMIT_PER_MIN=30
# Set to 1 only if Chromium will not start without --no-sandbox
PW_NO_SANDBOX=
# Optional: path to a Chromium binary (default: the one from `playwright install`)
PW_CHROMIUM_PATH=
# Page cache: seconds a page is kept after its last use, pages kept at once (0 = off)
PAGE_CACHE_TTL_S=60
PAGE_CACHE_MAX=3
