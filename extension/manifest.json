{
  "manifest_version": 3,
  "name": "עוזר הלמידה",
  "version": "0.1.0",
  "description": "עוזר לילדים ללמוד להשתמש ב-NotebookLM: שיעורים קצרים בעברית ומסגרת שמראה איפה ללחוץ.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "עוזר הלמידה",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
