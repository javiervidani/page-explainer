{
  "manifest_version": 3,
  "name": "עוזר הלמידה",
  "version": "0.2.0",
  "description": "עוזר לילדים ללמוד להשתמש ב-NotebookLM: שיעורים קצרים בעברית ומסגרת שמראה איפה ללחוץ.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content/util.js",
        "content/state.js",
        "content/styles.js",
        "content/ui.js",
        "content/speech.js",
        "content/player.js",
        "content/finder.js",
        "content/spotlight.js",
        "content/actions.js",
        "content/views.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "עוזר הלמידה",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lessons/media/*"
      ],
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ]
    }
  ]
}
