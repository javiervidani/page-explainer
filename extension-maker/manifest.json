{
  "manifest_version": 3,
  "name": "מכין השיעורים (לצוות)",
  "version": "0.2.3",
  "description": "לצוות: מסמנים כפתור במסך, שומרים את המסך ב-PageLens, ומכינים ממנו שיעור לילדים.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://pagelens.datashellv.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content/util.js",
        "content/log.js",
        "content/state.js",
        "content/styles.js",
        "content/ui.js",
        "content/labels.js",
        "content/picker.js",
        "content/finder.js",
        "content/actions.js",
        "content/remote.js",
        "content/views.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "מכין השיעורים",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
